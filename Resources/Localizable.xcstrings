    "Retry access to your configured hubs to trigger a pending local network request. If you previously denied access, enable BeszelBar in System Settings → Privacy & Security → Local Network." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retry access to your configured hubs to trigger a pending local network request. If you previously denied access, enable BeszelBar in System Settings → Privacy & Security → Local Network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez la connexion à vos hubs pour déclencher une demande d’accès au réseau local en attente. Si vous avez déjà refusé, autorisez BeszelBar dans Réglages Système → Confidentialité et sécurité → Réseau local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新访问已配置的监控中心，以触发本地网络权限请求。如果之前拒绝了访问，请前往“系统设置 → 隐私与安全性 → 本地网络”，允许 BeszelBar 访问。"
          }
        }
      }
